---
import "../styles/global.css";
import Sky from "../components/Sky.astro";
import Critters from "../components/Critters.astro";
import { getSite, locales, localeHref, sites } from "../i18n";
const site = getSite(Astro.currentLocale);
const other = site.lang.code === "he" ? sites.en : sites.he;
const { title = site.title, description = site.description } = Astro.props;
const origin = `https://${site.domain}`;
const url = new URL(Astro.url.pathname, origin).href;
// the same page in every language, for hreflang
const alternates = locales.map((l) => ({ l, href: new URL(localeHref(l, Astro.url.pathname), origin).href }));
const ogLocale = (code: string) => (code === "he" ? "he_IL" : "en_US");
const image = new URL(site.ogImage, origin).href;

// structured data for search and AI answer engines: who Avrik is, and the services as an
// offer catalog, one catalog per lane. The ids are shared by both languages, so the English
// and Hebrew pages describe the same person
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${origin}/#website`,
      url: `${origin}/`,
      name: site.fullName,
      description: site.description,
      inLanguage: locales,
      publisher: { "@id": `${origin}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${origin}/#person`,
      name: site.fullName,
      alternateName: other.fullName,
      jobTitle: site.role,
      description: site.description,
      url: `${origin}/`,
      email: `mailto:${site.email}`,
      sameAs: [site.linkedin, site.github],
      knowsLanguage: locales,
      knowsAbout: site.tiles.map((t) => t.label),
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: site.what.title,
        itemListElement: site.lanes.map((lane) => ({
          "@type": "OfferCatalog",
          name: lane.title,
          description: lane.line,
          itemListElement: site.tiles
            .filter((t) => t.lane === lane.id)
            .map((t) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name: t.label, description: t.detail } })),
        })),
      },
    },
  ],
};
// one font pair per language: the Latin faces have no Hebrew (see tokens.css).
// probe: the face the intro waits for before it runs
const fonts =
  site.lang.code === "he"
    ? {
        href: "https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;700&family=Secular+One&display=swap",
        probe: '400 1em "Secular One"',
      }
    : {
        href: "https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,800..900&family=Space+Grotesk:wght@400;500;700&display=swap",
        probe: "900 1em Archivo",
      };
---

<!doctype html>
<html lang={site.lang.code} dir={site.lang.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={url} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale(site.lang.code)} />
    <meta property="og:locale:alternate" content={ogLocale(other.lang.code)} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="theme-color" content="#161616" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fonts.href} rel="stylesheet" />
    <script is:inline define:vars={{ probe: fonts.probe }}>
      // html.js: JS is running, hero may start hidden. html.ready: display font is in, run the intro.
      (function () {
        var h = document.documentElement;
        h.classList.add("js");
        var go = function () {
          h.classList.add("ready");
        };
        var t = setTimeout(go, 1200);
        if (document.fonts && document.fonts.load) {
          document.fonts.load(probe).then(function () {
            clearTimeout(t);
            go();
          }, go);
        }
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga}`}></script>
    <script is:inline define:vars={{ ga: site.ga }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", ga);
    </script>
  </head>
  <body>
    <div class="frame">
      <Sky />
      <slot />
      <Critters />
    </div>
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
