const body = icons[name];
if (!body) throw new Error(`Icon "${name}" is not defined`);
---

<svg
  class={`ico ${cls}`}
  viewBox="0 0 48 48"
  width={size}
  height={size}
  aria-hidden="true"
  style={`--ico:${size}px`}
  set:html={body}
/>
