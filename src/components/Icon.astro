    <path d="M15 5v8M33 5v8" data-draw/>
    <path d="M16 29h6v6h-6z" data-draw/>`,
};
const body = icons[name];
if (!body) throw new Error(`Icon "${name}" is not defined`);
---

<svg
  class={`ico ${cls}`}
  viewBox="0 0 48 48"
  width={size}
  height={size}
  aria-hidden="true"
  style={`--ico:${size}px`}
  set:html={body}
/>
