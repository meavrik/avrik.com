---
// Hand-drawn stroke icons, 48×48, 3px strokes. Every path is marked data-draw so
// motion.ts can measure it and let it draw itself on reveal.
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 44, class: cls = "" } = Astro.props;

const icons: Record<string, string> = {
  terminal: `
    <rect x="5" y="9" width="38" height="30" rx="3" data-draw/>
    <path d="M13 19l7 5.5-7 5.5" data-draw/>
    <path d="M24 31h10" data-draw/>`,
  briefcase: `
    <rect x="5" y="15" width="38" height="25" rx="3" data-draw/>
    <path d="M17 15v-5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v5" data-draw/>
    <path d="M5 26h38" data-draw/>
    <path d="M21 26v4h6v-4" data-draw/>`,
  review: `
    <path d="M15 12L5 24l10 12" data-draw/>
    <path d="M33 12l10 12-10 12" data-draw/>
    <path d="M18 27l4 4 9-10" data-draw/>`,
  agent: `
    <circle cx="24" cy="12" r="5" data-draw/>
    <circle cx="11" cy="37" r="5" data-draw/>
    <circle cx="37" cy="37" r="5" data-draw/>
    <path d="M22 17l-9 15" data-draw/>
    <path d="M26 17l9 15" data-draw/>
    <path d="M16 37h16" data-draw/>`,
  repo: `
    <path d="M9 8h30v34H9z" data-draw/>
    <path d="M9 8c-2 0-3 2-3 4s1 4 3 4" data-draw/>
    <path d="M17 18l-5 6 5 6" data-draw/>
    <path d="M27 18l5 6-5 6" data-draw/>
    <path d="M18 36h12" data-draw/>`,
  inbox: `
    <path d="M6 28l5-16h26l5 16v10a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3z" data-draw/>
    <path d="M6 28h11l3 5h8l3-5h11" data-draw/>
    <path d="M24 6v12" data-draw/>
    <path d="M20 14l4 4 4-4" data-draw/>`,
  doc: `
    <path d="M11 5h18l9 9v29H11z" data-draw/>
    <path d="M29 5v9h9" data-draw/>
    <path d="M17 24h14" data-draw/>
    <path d="M17 31h14" data-draw/>
    <path d="M17 38h8" data-draw/>`,
  book: `
    <path d="M24 13c-4-4-11-5-18-4v29c7-1 14 0 18 4" data-draw/>
    <path d="M24 13c4-4 11-5 18-4v29c-7-1-14 0-18 4" data-draw/>
    <path d="M24 13v29" data-draw/>`,
  ear: `
    <path d="M14 20a10 10 0 0 1 20 0c0 7-7 9-7 15a6 6 0 0 1-12 0" data-draw/>
    <path d="M20 21a4 4 0 0 1 8 0c0 3-3 4-3 7" data-draw/>`,
  flask: `
    <path d="M19 6v13L8 38a3 3 0 0 0 3 5h26a3 3 0 0 0 3-5L29 19V6" data-draw/>
    <path d="M15 6h18" data-draw/>
    <path d="M13 32h22" data-draw/>
    <circle cx="22" cy="37" r="1.5" data-draw/>`,
  hand: `
    <path d="M10 26l8-8 8 2 8-2 7 7" data-draw/>
    <path d="M26 20l-5 5a3 3 0 0 0 4 4l4-4" data-draw/>
    <path d="M18 18l-8 8 10 10a3 3 0 0 0 4 0" data-draw/>
    <path d="M34 18l7 7-9 9a3 3 0 0 1-4 0" data-draw/>`,
  globe: `
    <circle cx="24" cy="24" r="18" data-draw/>
    <ellipse cx="24" cy="24" rx="8" ry="18" data-draw/>
    <path d="M6 24h36" data-draw/>
    <path d="M9 15h30M9 33h30" data-draw/>`,
  spark: `
    <path d="M24 4c1 10 7 16 17 20-10 4-16 10-17 20-1-10-7-16-17-20 10-4 16-10 17-20z" data-draw/>`,
  arrow: `
    <path d="M6 24h34" data-draw/>
    <path d="M28 12l12 12-12 12" data-draw/>`,
  mail: `
    <rect x="5" y="11" width="38" height="26" rx="3" data-draw/>
    <path d="M6 14l18 13 18-13" data-draw/>`,
  calendar: `
    <rect x="6" y="9" width="36" height="33" rx="3" data-draw/>
