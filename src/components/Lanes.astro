---
import { getSite } from "../i18n";
import Icon from "./Icon.astro";
import LaneArt from "./LaneArt.astro";
import Roadmap from "./Roadmap.astro";
const site = getSite(Astro.currentLocale);
// 16-point starburst for the "ship it!" sticker
const burst = Array.from({ length: 32 }, (_, i) => {
  const r = i % 2 ? 46 : 58;
  const a = (i * Math.PI) / 16;
  return `${(60 + r * Math.cos(a)).toFixed(1)},${(60 + r * Math.sin(a)).toFixed(1)}`;
}).join(" ");
const { cta } = site.roadmap;
---

<section class="section wrap" id="who">
  <h2 class="section-title reveal">{site.lanesTitle}</h2>
  <div class="lanes">
    {
      site.lanes.map((lane, i) => (
        <article class={`lane ${lane.id} box reveal`} data-lane={lane.id} style={`--i:${i}`}>
          {/* dev gets a starburst on its corner, biz a speech bubble */}
          {lane.id === "dev" ? (
            <svg class="burst" viewBox="0 0 120 120" aria-hidden="true">
              <polygon points={burst} />
              <text x="60" y="66" text-anchor="middle">
                {lane.sticker}
              </text>
            </svg>
          ) : (
            <svg class="bubble" viewBox="0 0 130 100" aria-hidden="true">
              <path d="M16 6h98a10 10 0 0 1 10 10v44a10 10 0 0 1-10 10H60L40 90V70H16A10 10 0 0 1 6 60V16A10 10 0 0 1 16 6z" />
              <text x="65" y="46" text-anchor="middle">
                {lane.sticker}
              </text>
            </svg>
          )}
          <span class="label">
            0{i + 1} — {lane.title}
          </span>
          <h3>{lane.line}</h3>

          <div class="art" data-tilt>
            <LaneArt lane={lane.id} />
          </div>

          <button
            class="cta"
            type="button"
            data-roadmap-open={lane.id}
            data-label-show={cta.show}
            data-label-hide={cta.hide}
            aria-controls="roadmap"
            aria-expanded="false"
          >
            <span class="cta-label display">{cta.show}</span>
            <span class="cta-arrow" aria-hidden="true">
              <Icon name="arrow" size={20} class="in" />
            </span>
          </button>
        </article>
      ))
    }
  </div>

  <Roadmap />
</section>

<style>
  .lanes {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr);
    gap: clamp(16px, 2.5vw, 28px);
  }
  /* label, headline, the process illustration, then the call to action */
  .lane {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 14px;
    justify-items: start;
    padding: clamp(24px, 3vw, 40px);
    background: var(--lane);
    border-radius: var(--r-lg);
  }
  h3 {
    font-size: var(--step-3);
    max-width: 16ch;
  }
  .art {
    align-self: end;
    justify-self: stretch;
    margin-block: 18px 6px;
    perspective: 900px;
  }
  /* the call to action: a lifted yellow pill, the one thing with a shadow */
  .cta {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 10px;
    padding: 10px;
    padding-inline-start: 22px;
    font: inherit;
    color: inherit;
    background: var(--yellow);
    border: var(--bw) solid var(--ink);
    border-radius: var(--pill);
    box-shadow: var(--lift);
    cursor: pointer;
    transition:
      transform var(--fast) var(--ease-out),
      box-shadow var(--fast) var(--ease-out);
  }
  @media (hover: hover) {
    .cta:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 var(--ink);
    }
  }
  .cta:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }
  .cta-label {
    font-size: 1rem;
  }
  .cta-arrow {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    background: var(--ink);
    border-radius: var(--pill);
    animation: bob 1.6s ease-in-out infinite;
  }
  .cta-arrow :global(.ico) {
    stroke: var(--paper-2);
    stroke-width: 4;
    rotate: 90deg;
    transition: rotate var(--base) var(--ease);
  }
  .cta[aria-expanded="true"] .cta-arrow {
    animation: none;
  }
  .cta[aria-expanded="true"] .cta-arrow :global(.ico) {
    rotate: -90deg;
  }
  @keyframes bob {
    50% {
      transform: translateY(3px);
    }
  }

  /* stickers, slapped on each card's top corner */
  .burst,
  .bubble {
    position: absolute;
    z-index: 2;
    font-family: var(--display);
    font-weight: 900;
    font-stretch: 112%;
    text-transform: uppercase;
  }
  .burst {
    width: 118px;
    top: -34px;
    inset-inline-end: 22px;
    transform: rotate(-12deg);
  }
  .burst polygon {
    fill: var(--blue);
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .burst text {
    font-size: 15px;
    fill: var(--ink);
  }
  .bubble {
    width: 124px;
    top: -30px;
    inset-inline-end: 18px;
    transform: rotate(6deg);
  }
  .bubble path {
    fill: var(--paper-2);
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .bubble text {
    font-size: 20px;
    fill: var(--ink);
  }

  @media (max-width: 920px) {
    .lanes {
      grid-template-columns: 1fr;
    }
  }
  /* phones: the burst shrinks and rides higher so it clears the headline */
  @media (max-width: 600px) {
    .burst {
      width: 92px;
      top: -46px;
      inset-inline-end: 10px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-arrow {
      animation: none;
    }
    .cta {
      transition: none;
    }
  }
</style>
