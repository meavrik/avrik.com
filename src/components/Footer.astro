---
import { getSite, sites, locales, localeHref } from "../i18n";
const site = getSite(Astro.currentLocale);
const here = Astro.url.pathname;
const others = locales.filter((l) => l !== site.lang.code);
---

<footer>
  <div class="wrap row label">
    <span>{site.footer.text}</span>
    <span class="links">
      <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn <span class="mirror" aria-hidden="true">↗</span></a>
      <a href={site.github} target="_blank" rel="noopener">GitHub <span class="mirror" aria-hidden="true">↗</span></a>
      {
        others.map((l) => (
          <a href={localeHref(l, here)} lang={l} hreflang={l} dir={sites[l].lang.dir}>
            {sites[l].lang.name}
          </a>
        ))
      }
    </span>
  </div>
</footer>

<style>
  footer {
    border-top: var(--bw) solid var(--ink);
  }
  .row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-block: 24px 32px;
    font-weight: 500;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
</style>
