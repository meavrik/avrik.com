---
import { getSite } from "../i18n";
import Portrait from "./Portrait.astro";
const site = getSite(Astro.currentLocale);
const { bio } = site;
---

<!-- the story on the reading side, the cartoon beside it; on phones the cartoon comes first -->
<section class="section wrap" id="bio">
  <div class="bio">
    <div class="story">
      <span class="label reveal">{bio.label}</span>
      <h2 class="section-title reveal" style="--i:1">{bio.title}</h2>
      <div class="about">
        {
          bio.about.map((p, i) => (
            <p class="reveal" style={`--i:${i + 2}`}>
              {p}
            </p>
          ))
        }
      </div>
      <p class="closer display reveal" style={`--i:${bio.about.length + 2}`}>
        <span>{bio.closer}</span>
      </p>
    </div>

    <div class="portrait reveal" style="--i:1"><Portrait /></div>
  </div>
</section>

<style>
  .bio {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .story {
    display: grid;
    justify-items: start;
  }
  .story > .label {
    margin-bottom: 14px;
  }
  .section-title {
    margin-bottom: 20px;
  }
  .about {
    display: grid;
    gap: 14px;
    font-size: var(--step-1);
    max-width: 46ch;
  }
  /* the sign-off: display type on a yellow highlighter stroke */
  .closer {
    margin-top: 24px;
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    line-height: 1.15;
  }
  .closer span {
    background: linear-gradient(transparent 55%, var(--yellow) 55%, var(--yellow) 92%, transparent 92%);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* the cartoon has its own column now, so it can be drawn large (the whole drawing scales with --me-size) */
  .portrait {
    --me-size: clamp(10px, 1.3vw, 17px);
    justify-self: center;
  }

  @media (max-width: 820px) {
    .bio {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .portrait {
      --me-size: 11px;
      order: -1;
      justify-self: start;
    }
  }
</style>
