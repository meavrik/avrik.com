---
import { getSite, sites, locales, localeHref } from "../i18n";
import Icon from "./Icon.astro";
const site = getSite(Astro.currentLocale);
const here = Astro.url.pathname;
const home = `${localeHref(site.lang.code, "/")}#top`;
// the other language: the orange sticker at the end of the bar is stamped with its short name
const others = locales.filter((l) => l !== site.lang.code);
---

<header class="nav">
  <div class="wrap row">
    <!-- the logo reads left to right in every language -->
    <a href={home} class="logo label" dir="ltr">
      <Icon name="globe" size={22} class="in" />
      avrik<span>.com</span>
    </a>
    <nav aria-label={site.navLabel} class="links">
      {
        site.nav.map((n) => (
          <a class="label" href={n.href} aria-current={n.href === here ? "page" : undefined}>
            {n.label}
          </a>
        ))
      }
    </nav>
    <div class="right">
      <a class="btn btn-sm press" href={site.contact.href}>
        {site.contact.label} <span class="mirror" aria-hidden="true">↗</span>
      </a>
      <!-- language switch: the same page in the other language -->
      {
        others.map((l) => (
          <a
            class="disc display press"
            href={localeHref(l, here)}
            lang={l}
            hreflang={l}
            dir={sites[l].lang.dir}
            title={sites[l].lang.name}
            aria-label={sites[l].lang.name}
          >
            {sites[l].lang.short}
          </a>
        ))
      }
    </div>
  </div>
</header>

<style>
  .nav {
    border-bottom: var(--bw) solid var(--ink);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 16px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .logo span {
    opacity: 0.5;
  }
  .logo :global(.ico) {
    stroke-width: 3.5;
  }
  .links {
    display: flex;
    gap: clamp(14px, 3vw, 40px);
  }
  .links a {
    text-decoration: none;
    padding: 6px 2px;
    border-bottom: 2px solid transparent;
    transition: border-color var(--fast);
  }
  .links a:hover,
  .links a[aria-current] {
    border-color: var(--ink);
  }
  .right {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .btn-sm {
    padding: 8px 16px;
  }
  /* the orange sticker at the end of the bar: the language switch, lifts like a button */
  .disc {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    font-size: 0.72rem;
    text-decoration: none;
    background: var(--orange);
    border: var(--bw) solid var(--ink);
    border-radius: var(--pill);
  }
  @media (max-width: 640px) {
    .links,
    .logo span {
      display: none;
    }
  }
</style>
