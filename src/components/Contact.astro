---
import { getSite } from "../i18n";
import Icon from "./Icon.astro";
const site = getSite(Astro.currentLocale);
---

<section class="section wrap" id="talk">
  <div class="panel box reveal">
    <span class="spark" aria-hidden="true">✦</span>
    <h2>{site.talk.headline}</h2>
    <p>{site.talk.sub}</p>
    <div class="actions">
      <a class="btn btn-primary btn-xl press" href={site.calendar}>
        <Icon name="calendar" size={24} />
        {site.talk.cta}
      </a>
      <a class="mail" href={`mailto:${site.email}`}>
        <Icon name="mail" size={22} />
        <span dir="ltr">{site.email}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative;
    padding: clamp(32px, 6vw, 80px);
    background: var(--teal);
    color: var(--paper-2);
    border-radius: var(--r-lg);
    display: grid;
    gap: 16px;
    justify-items: start;
    overflow: hidden;
  }
  .spark {
    position: absolute;
    top: 12px;
    inset-inline-end: 24px;
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 1;
    color: var(--yellow);
    -webkit-text-stroke: 2px var(--ink);
  }
  h2 {
    font-size: var(--step-7);
  }
  p {
    font-size: var(--step-1);
    opacity: 0.9;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    margin-top: 24px;
  }
  .btn :global(.ico) {
    stroke: var(--ink);
  }
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    font-size: var(--step-0);
    text-decoration: none;
    border-bottom: 2px solid var(--yellow);
    padding-bottom: 2px;
  }
  .mail :global(.ico) {
    stroke: var(--paper-2);
  }
  .mail:hover {
    color: var(--yellow);
  }
</style>
